generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  vendor
  customer
  admin
}

model User {
  userid       String         @id @default(uuid())
  email        String         @unique
  name         String?
  role         UserType
  password     String
  orderDetails OrderDetails[]      
  stores       Store[]            
}

model Product {
  productId    String         @id @default(uuid())
  productName  String
  productPrice Float

  warehouseId  String
  warehouse    WareHouse      @relation(fields: [warehouseId], references: [warehouseId])

  sales        Sales[]
  orders       Order[]        // orders that reference this product

  storeProducts StoreAndProduct[]
}

model City {
  cityId           String             @id @default(uuid())
  cityName         String             @unique
  state            String

  warehouses       WareHouse[]
  warehouseDetails WarehouseDetails[]
}

model WareHouse {
  warehouseId       String   @id @default(uuid())
  warehouseName     String
  warehouseCapacity Int

  cityId String
  city   City     @relation(fields: [cityId], references: [cityId])

  products         Product[]
  warehouseDetails WarehouseDetails[]
}

model WarehouseDetails {
  warehouseId String
  cityId      String

  warehouse   WareHouse @relation(fields: [warehouseId], references: [warehouseId])
  city        City      @relation(fields: [cityId], references: [cityId])

  @@id([cityId, warehouseId])
}

model Sales {
  id         String  @id @default(uuid())
  productName String
  quantity   Int
  price      Float

  productId  String
  product    Product @relation(fields: [productId], references: [productId])
}

model Store {
  storeId   String            @id @default(cuid())
  storeName String

  // vendor connection (the store owner)
  vendorId  String
  vendor    User              @relation(fields: [vendorId], references: [userid])

  storeProducts StoreAndProduct[]
}

model StoreAndProduct {
  storeId    String
  productId  String
  productName String?

  store   Store   @relation(fields: [storeId], references: [storeId])
  product Product @relation(fields: [productId], references: [productId])

  @@id([storeId, productId])
}

model Order {
  orderId    String  @id @default(uuid())
  quantity   Int
  totalPrice Float

  productId  String
  product    Product @relation(fields: [productId], references: [productId])

  orderDetails OrderDetails[]
}

model OrderDetails {
  orderId String
  userId  String

  order Order @relation(fields: [orderId], references: [orderId])
  user  User  @relation(fields: [userId], references: [userid])

  @@id([orderId, userId])
}
