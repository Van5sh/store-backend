generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  vendor
  customer
  admin
}

enum OrderStatus {
  pending
  shipped
  delivered
  cancelled
}

enum ProductCategory {
  electronics
  clothing
  home_appliances
  books
  toys
  sports
}

model User {
  userid           String   @id @default(uuid())
  email            String   @unique
  name             String?
  role             UserType
  password         String

  orders           Order[] @relation("OrderCustomer")
  vendorOrders     Order[] @relation("OrderVendor")

  orderDetails     OrderDetails[]
  complaints       Complaint[]
  complaintDetails ComplaintDetails[]

  stores           Store[]
  storeAndProducts StoreAndProduct[]

  warehouseDetails WarehouseDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  productId    String @id @default(uuid())
  productName  String
  productPrice Float
  category     ProductCategory @default(electronics)

  inventory     WarehouseInventory[]
  sales         Sales[]
  orders        Order[] @relation("ProductOrders")
  storeProducts StoreAndProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  cityId   String @id @default(uuid())
  cityName String @unique
  state    String

  warehouses       WareHouse[]
  warehouseDetails WarehouseDetails[]
  stores           Store[]

  createdAt DateTime @default(now())
}

model WareHouse {
  warehouseId       String @id @default(uuid())
  warehouseName     String
  warehouseCapacity Int

  cityId String
  city   City @relation(fields: [cityId], references: [cityId])

  warehouseDetails   WarehouseDetails[]
  warehouseInventory WarehouseInventory[]
  orders             Order[]
}

model WarehouseDetails {
  warehouseId String
  cityId      String
  userId      String

  warehouse WareHouse @relation(fields: [warehouseId], references: [warehouseId])
  city      City      @relation(fields: [cityId], references: [cityId])
  user      User      @relation(fields: [userId], references: [userid])

  @@id([cityId, warehouseId, userId])
}

model WarehouseInventory {
  warehouseId String
  productId   String

  quantity Int @default(0)

  warehouse WareHouse @relation(fields: [warehouseId], references: [warehouseId], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [productId], onDelete: Cascade)

  @@id([warehouseId, productId])
}

model Store {
  storeId   String @id @default(cuid())
  storeName String

  vendorId String
  cityName String

  vendor User @relation(fields: [vendorId], references: [userid])
  city   City @relation(fields: [cityName], references: [cityName])

  storeProducts StoreAndProduct[]
  orders        Order[] @relation("StoreOrders")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vendorId, cityName, storeName])
}

model StoreAndProduct {
  storeId   String
  productId String
  vendorId  String

  store   Store   @relation(fields: [storeId], references: [storeId], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [productId], onDelete: Cascade)
  vendor  User    @relation(fields: [vendorId], references: [userid], onDelete: Cascade)

  @@id([storeId, productId, vendorId])
}

model Order {
  orderId    String   @id @default(uuid())
  quantity   Int
  totalPrice Float
  orderDate  DateTime @default(now())
  status     OrderStatus @default(pending)

  productId String
  product   Product @relation("ProductOrders", fields: [productId], references: [productId])

  storeId String
  store   Store @relation("StoreOrders", fields: [storeId], references: [storeId])

  customerId String
  customer   User @relation("OrderCustomer", fields: [customerId], references: [userid])

  vendorId String
  vendor   User @relation("OrderVendor", fields: [vendorId], references: [userid])

  warehouseId String
  warehouse   WareHouse @relation(fields: [warehouseId], references: [warehouseId])

  orderDetails     OrderDetails[]
  complaints       Complaint[]
  complaintDetails ComplaintDetails[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderDetails {
  orderId String
  userId  String

  order Order @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [userid], onDelete: Cascade)

  @@id([orderId, userId])
}

model Sales {
  id        String @id @default(uuid())
  productId String
  quantity  Int
  price     Float

  product Product @relation(fields: [productId], references: [productId])
}

model Complaint {
  complaintId String   @id @default(uuid())
  title       String
  content     String
  priority    Int
  createdAt   DateTime @default(now())
  deliveryDate DateTime

  userId String
  user   User @relation(fields: [userId], references: [userid])

  orderId String
  order   Order @relation(fields: [orderId], references: [orderId])

  complaintDetails ComplaintDetails[]
}

model ComplaintDetails {
  id          String @id @default(uuid())
  complaintId String
  userId      String
  orderId     String

  user      User      @relation(fields: [userId], references: [userid], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [orderId], onDelete: Cascade)
  complaint Complaint @relation(fields: [complaintId], references: [complaintId], onDelete: Cascade)
}
