generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserType {
  vendor
  customer
  admin
}

model User {
  userid           String             @id @default(uuid())
  email            String             @unique
  name             String?
  role             UserType
  password         String
  orderDetails     OrderDetails[]
  stores           Store[]
  Complaints       Complaint[]
  WarehouseDetails WarehouseDetails[]
  orders           Order[]
}

model Product {
  productId    String @id @default(uuid())
  productName  String
  productPrice Float

  warehouseId String
  warehouse   WareHouse @relation(fields: [warehouseId], references: [warehouseId])

  sales  Sales[]
  orders Order[]

  storeProducts StoreAndProduct[]
}

model City {
  cityId   String @id @default(uuid())
  cityName String @unique
  state    String

  warehouses       WareHouse[]
  warehouseDetails WarehouseDetails[]
  Stores           Store[]
}

model WareHouse {
  warehouseId       String @id @default(uuid())
  warehouseName     String
  warehouseCapacity Int

  cityId String
  city   City   @relation(fields: [cityId], references: [cityId])

  products         Product[]
  warehouseDetails WarehouseDetails[]
}

model WarehouseDetails {
  warehouseId String
  cityId      String
  userId      String

  warehouse WareHouse @relation(fields: [warehouseId], references: [warehouseId])
  city      City      @relation(fields: [cityId], references: [cityId])
  user      User      @relation(fields: [userId], references: [userid])

  @@id([cityId, warehouseId])
}

model Sales {
  id          String @id @default(uuid())
  productName String
  quantity    Int
  price       Float

  productId String
  product   Product @relation(fields: [productId], references: [productId])
}

model Store {
  storeId   String @id @default(cuid())
  storeName String

  vendorId String
  cityId   String
  vendor   User   @relation(fields: [vendorId], references: [userid])
  city     City   @relation(fields: [cityId], references: [cityId])

  storeProducts StoreAndProduct[]
}

model StoreAndProduct {
  storeId     String
  productId   String
  productName String?

  store   Store   @relation(fields: [storeId], references: [storeId])
  product Product @relation(fields: [productId], references: [productId])

  @@id([storeId, productId])
}

model Order {
  orderId    String   @id @default(uuid())
  quantity   Int
  totalPrice Float
  orderDate  DateTime @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [productId])

  vendorId String
  vendor   User   @relation(fields: [vendorId], references: [userid])

  orderDetails OrderDetails[]
  complaints   Complaint[]
}

model OrderDetails {
  orderId String
  userId  String

  order Order @relation(fields: [orderId], references: [orderId])
  user  User  @relation(fields: [userId], references: [userid])

  @@id([orderId, userId])
}

model Complaint {
  complaintId String   @id @default(uuid())
  content     String
  createdAt   DateTime @default(now())

  userId  String
  user    User   @relation(fields: [userId], references: [userid])
  orderId String
  order   Order  @relation(fields: [orderId], references: [orderId])
}
